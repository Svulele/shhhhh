OPENROUTER_API_KEY=your_openrouter_api_key_here
FRONTEND_ORIGINS=https://your-frontend.vercel.app
OPENROUTER_MODEL=

SUPABASE_URL=https://your-project.supabase.co
# Optional: public publishable/anon key for server verification. Never a VITE secret.
SUPABASE_ANON_KEY=
# Server only: required after locking anonymous feedback inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional feedback CAPTCHA; same widget secret configured in Supabase Auth.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=shhhhh-ten.vercel.app
